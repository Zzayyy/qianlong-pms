# 复制为 .env 后填写真实值；.env 禁止提交到版本库
APP_ENV=dev
APP_NAME=PMS
APP_HOST=0.0.0.0
APP_PORT=8000
APP_SECRET_KEY=please-change-me

# MySQL（设计稿 02 §4：192.168.1.136 / qloffice）
DB_HOST=192.168.1.136
DB_PORT=3306
DB_USER=qloffice
DB_PASSWORD=Office135246
DB_NAME=qloffice
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Redis（会话黑名单 / 参数缓存 / 幂等键）
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# JWT
JWT_SECRET_KEY=please-change-me-too
JWT_EXPIRE_MINUTES=120

# 附件（本地磁盘，设计稿 00 §5）
UPLOAD_DIR=data/uploads
UPLOAD_MAX_MB=20

# CORS（前端 dev server）
CORS_ORIGINS=http://localhost:5173

# 可信反向代理（审计留痕取真实 IP）：只有来自这些地址的请求才采信
# X-Forwarded-For / X-Real-IP；默认本机回环，Nginx 部署在其他机器时追加其 IP
TRUSTED_PROXIES=127.0.0.1,::1
